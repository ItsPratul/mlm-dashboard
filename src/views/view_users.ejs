<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="utf-8">

  <meta
    content="width=device-width, initial-scale=1.0"
    name="viewport"
  >

  <title>
    User Manager
  </title>

  <!-- Favicon -->

  <link
    href="/assets/img/favicon.png"
    rel="icon"
  >

  <!-- Google Fonts -->

  <link
    href="https://fonts.gstatic.com"
    rel="preconnect"
  >

  <link
    href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700|Nunito:300,400,600,700|Poppins:300,400,500,600,700"
    rel="stylesheet"
  >

  <!-- Vendor CSS -->

  <link
    href="/assets/vendor/bootstrap/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    href="/assets/vendor/bootstrap-icons/bootstrap-icons.css"
    rel="stylesheet"
  >

  <link
    href="/assets/vendor/boxicons/css/boxicons.min.css"
    rel="stylesheet"
  >

  <link
    href="/assets/vendor/remixicon/remixicon.css"
    rel="stylesheet"
  >

  <link
    href="/assets/vendor/simple-datatables/style.css"
    rel="stylesheet"
  >

  <!-- Main CSS -->

  <link
    href="/assets/css/style.css"
    rel="stylesheet"
  >

  <style>

    body {

      background: #f4f7ff;

    }

    .page-title {

      font-size: 30px;

      font-weight: 700;

      color: #012970;

    }

    .search-card,
    .table-card {

      border: none;

      border-radius: 24px;

      box-shadow: 0 6px 25px rgba(0,0,0,0.06);

    }

    .card-title {

      font-size: 24px;

      font-weight: 700;

      color: #012970;

    }

    .form-control {

      height: 50px;

      border-radius: 14px;

      border: 1px solid #dbe2ef;

      box-shadow: none;

    }

    .form-control:focus {

      border-color: #0d6efd;

      box-shadow: none;

    }

    .search-btn {

      height: 50px;

      border-radius: 14px;

      font-weight: 700;

    }

    .table thead {

      background: #012970;

      color: white;

    }

    .table thead th {

      padding: 16px;

      font-size: 14px;

      white-space: nowrap;

    }

    .table tbody td {

      padding: 18px 16px;

      vertical-align: middle;

      white-space: nowrap;

    }

    .user-image {

      width: 55px;

      height: 55px;

      border-radius: 50%;

      object-fit: cover;

      border: 3px solid #e8ecff;

    }

    .user-name {

      font-weight: 700;

      color: #012970;

      margin-bottom: 3px;

    }

    .user-email {

      font-size: 13px;

      color: #6c757d;

    }

    .wallet-badge {

      background: #e8fff1;

      color: #198754;

      padding: 8px 14px;

      border-radius: 30px;

      font-weight: 700;

      font-size: 13px;

    }

    .gender-badge {

      background: #eef3ff;

      color: #012970;

      padding: 8px 14px;

      border-radius: 30px;

      font-weight: 700;

      font-size: 13px;

    }

    .parent-badge {

      background: #fff4e5;

      color: #ff8800;

      padding: 8px 14px;

      border-radius: 30px;

      font-weight: 700;

      font-size: 13px;

    }

    .update-button {

      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding: 10px 18px;

      border-radius: 14px;

      background: #012970;

      color: white;

      text-decoration: none;

      font-weight: 700;

      transition: 0.3s;

    }

    .update-button:hover {

      background: #0d6efd;

      color: white;

      transform: translateY(-2px);

    }

  </style>

</head>

<body>

  <!-- HEADER -->

  <%- include("../../utils/header") %>

  <!-- SIDEBAR -->

  <%- include("../../utils/side") %>

  <!-- MAIN -->

  <main
    id="main"
    class="main"
  >

    <!-- PAGE TITLE -->

    <div class="pagetitle mb-4">

      <%- include("../../utils/flash") %>

      <h1 class="page-title">
        User Manager
      </h1>

      <nav>

        <ol class="breadcrumb">

          <li class="breadcrumb-item">
            <a href="/user_dashboard">
              Home
            </a>
          </li>

          <li class="breadcrumb-item active">
            Users
          </li>

        </ol>

      </nav>

    </div>

    <!-- SEARCH SECTION -->

    <div class="card search-card mb-4">

      <div class="card-body p-4">

        <h5 class="card-title mb-4">
          Search Users
        </h5>

        <form
          class="row g-3"
          action="/view_users"
          method="GET"
        >

          <!-- USER NAME -->

          <div class="col-md-4">

            <label class="form-label">
              User Name
            </label>

            <input
              type="text"
              class="form-control"
              name="filtername"
              placeholder="Search by user name"
            >

          </div>

          <!-- MOBILE -->

          <div class="col-md-3">

            <label class="form-label">
              Mobile Number
            </label>

            <input
              type="text"
              class="form-control"
              name="filtermobile"
              placeholder="Search by mobile"
            >

          </div>

          <!-- EMAIL -->

          <div class="col-md-5">

            <label class="form-label">
              Email Address
            </label>

            <input
              type="email"
              class="form-control"
              name="filteremail"
              placeholder="Search by email"
            >

          </div>

          <!-- BUTTON -->

          <div class="col-md-12 text-center mt-3">

            <button
              type="submit"
              class="btn btn-primary search-btn"
            >
              Search Users
            </button>

          </div>

        </form>

      </div>

    </div>

    <!-- USER TABLE -->

    <section class="section">

      <div class="card table-card">

        <div class="card-body p-4">

          <h5 class="card-title mb-4">
            All Users
          </h5>

          <div class="table-responsive">

            <table class="table table-hover align-middle datatable">

              <thead>

                <tr>

                  <th>S No.</th>

                  <th>Profile</th>

                  <th>User Details</th>

                  <th>User ID</th>

                  <th>Parent ID</th>

                  <th>Wallet</th>

                  <th>Gender</th>

                  <th>Action</th>

                </tr>

              </thead>

              <tbody>

                <% let i = 1; %>

                <% for(let dataobj of users){ %>

                  <tr>

                    <!-- SERIAL -->

                    <td>
                      <%= i++ %>
                    </td>

                    <!-- PROFILE PHOTO -->

                    <td>

                      <img
                        src="<%= dataobj.profile_photo || '/assets/img/profile-img.jpg' %>"
                        alt="User"
                        class="user-image"
                      >

                    </td>

                    <!-- USER DETAILS -->

                    <td>

                      <div class="user-name">
                        <%= dataobj.name %>
                      </div>

                      <div class="user-email">
                        <%= dataobj.email %>
                      </div>

                      <div class="user-email">
                        <%= dataobj.mobile %>
                      </div>

                    </td>

                    <!-- USER ID -->

                    <td>

                      <span class="badge bg-primary p-2 px-3">
                        <%= dataobj.user_id %>
                      </span>

                    </td>

                    <!-- PARENT ID -->

                    <td>

                      <% if(dataobj.parent_id){ %>

                        <span class="parent-badge">
                          <%= dataobj.parent_id %>
                        </span>

                      <% } else { %>

                        <span class="badge bg-dark p-2 px-3">
                          ROOT USER
                        </span>

                      <% } %>

                    </td>

                    <!-- WALLET -->

                    <td>

                      <span class="wallet-badge">
                        ₹ <%= dataobj.wallet %>
                      </span>

                    </td>

                    <!-- GENDER -->

                    <td>

                      <span class="gender-badge">
                        <%= dataobj.gender || 'N/A' %>
                      </span>

                    </td>

                    <!-- ACTION -->

                    <td>

                      <a
                        href="/update_user/<%= dataobj.user_id %>"
                        class="update-button"
                      >

                        <i class="bi bi-pencil-square"></i>

                        Update

                      </a>

                    </td>

                  </tr>

                <% } %>

              </tbody>

            </table>

          </div>

        </div>

      </div>

    </section>

  </main>

  <!-- FOOTER -->

  <%- include("../../utils/footer") %>

  <!-- BACK TO TOP -->

  <a
    href="#"
    class="back-to-top d-flex align-items-center justify-content-center"
  >
    <i class="bi bi-arrow-up-short"></i>
  </a>

  <!-- JS -->

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

  <script src="/assets/vendor/simple-datatables/simple-datatables.js"></script>

  <script src="/assets/js/main.js"></script>

</body>

</html>
