<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="utf-8">

  <meta
    content="width=device-width, initial-scale=1.0"
    name="viewport"
  >

  <title>
    Add Balance
  </title>

  <!-- Favicons -->

  <link
    href="/assets/img/favicon.png"
    rel="icon"
  >

  <!-- Google Fonts -->

  <link
    href="https://fonts.gstatic.com"
    rel="preconnect"
  >

  <link
    href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700|Nunito:300,400,600,700|Poppins:300,400,500,600,700"
    rel="stylesheet"
  >

  <!-- Vendor CSS -->

  <link
    href="/assets/vendor/bootstrap/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    href="/assets/vendor/bootstrap-icons/bootstrap-icons.css"
    rel="stylesheet"
  >

  <link
    href="/assets/vendor/boxicons/css/boxicons.min.css"
    rel="stylesheet"
  >

  <link
    href="/assets/vendor/remixicon/remixicon.css"
    rel="stylesheet"
  >

  <!-- Main CSS -->

  <link
    href="/assets/css/style.css"
    rel="stylesheet"
  >

  <style>

    body {

      background: #f4f7ff;

    }

    .page-title {

      font-size: 30px;

      font-weight: 700;

      color: #012970;

    }

    .wallet-card {

      border: none;

      border-radius: 28px;

      overflow: hidden;

      box-shadow: 0 10px 35px rgba(0,0,0,0.08);

      background: white;

    }

    .wallet-header {

      background: linear-gradient(
        135deg,
        #012970,
        #0d6efd
      );

      padding: 40px;

      color: white;

      position: relative;

    }

    .wallet-header h2 {

      font-size: 34px;

      font-weight: 700;

      margin-bottom: 10px;

    }

    .wallet-header p {

      font-size: 15px;

      opacity: 0.9;

      margin: 0;

    }

    .wallet-icon {

      position: absolute;

      right: 35px;

      top: 30px;

      font-size: 70px;

      opacity: 0.15;

    }

    .wallet-body {

      padding: 45px;

    }

    .wallet-balance-box {

      background: linear-gradient(
        135deg,
        #e8fff1,
        #d8fce5
      );

      border-radius: 24px;

      padding: 30px;

      text-align: center;

      margin-bottom: 40px;

    }

    .wallet-balance-box h6 {

      font-size: 15px;

      color: #198754;

      margin-bottom: 10px;

      font-weight: 700;

    }

    .wallet-balance {

      font-size: 42px;

      font-weight: 800;

      color: #198754;

    }

    .form-label {

      font-weight: 700;

      color: #012970;

      margin-bottom: 12px;

    }

    .input-group {

      border-radius: 18px;

      overflow: hidden;

      box-shadow: 0 4px 14px rgba(0,0,0,0.05);

    }

    .input-group-text {

      background: #012970;

      color: white;

      border: none;

      padding: 0 22px;

      font-size: 22px;

      font-weight: 700;

    }

    .form-control {

      height: 60px;

      border: none;

      font-size: 18px;

      font-weight: 600;

      padding-left: 18px;

      box-shadow: none;

    }

    .form-control:focus {

      box-shadow: none;

    }

    .submit-btn {

      height: 58px;

      border: none;

      border-radius: 18px;

      background: linear-gradient(
        135deg,
        #012970,
        #0d6efd
      );

      color: white;

      font-size: 17px;

      font-weight: 700;

      padding: 0 40px;

      transition: 0.3s;

    }

    .submit-btn:hover {

      transform: translateY(-2px);

      box-shadow: 0 10px 20px rgba(13,110,253,0.2);

    }

    .reset-btn {

      height: 58px;

      border-radius: 18px;

      font-size: 17px;

      font-weight: 700;

      padding: 0 40px;

    }

    .quick-amounts {

      margin-top: 25px;

      display: flex;

      gap: 12px;

      flex-wrap: wrap;

    }

    .quick-btn {

      border: none;

      background: #eef3ff;

      color: #012970;

      padding: 12px 20px;

      border-radius: 14px;

      font-weight: 700;

      transition: 0.3s;

    }

    .quick-btn:hover {

      background: #012970;

      color: white;

    }

  </style>

</head>

<body>

  <!-- HEADER -->

  <%- include("../../utils/header") %>

  <!-- SIDEBAR -->

  <%- include("../../utils/side") %>

  <!-- MAIN -->

  <main
    id="main"
    class="main"
  >

    <!-- PAGE TITLE -->

    <div class="pagetitle mb-4">

      <%- include("../../utils/flash") %>

      <h1 class="page-title">
        Add Balance
      </h1>

      <nav>

        <ol class="breadcrumb">

          <li class="breadcrumb-item">
            <a href="/user_dashboard">
              Home
            </a>
          </li>

          <li class="breadcrumb-item">
            Wallet Manager
          </li>

          <li class="breadcrumb-item active">
            Add Balance
          </li>

        </ol>

      </nav>

    </div>

    <!-- WALLET SECTION -->

    <section class="section">

      <div class="card wallet-card">

        <!-- HEADER -->

        <div class="wallet-header">

          <i class="bi bi-wallet2 wallet-icon"></i>

          <h2>
            Add Money To Wallet
          </h2>

          <p>
            Instantly add balance to your wallet safely and securely.
          </p>

        </div>

        <!-- BODY -->

        <div class="wallet-body">

          <!-- WALLET BALANCE -->

          <div class="wallet-balance-box">

            <h6>
              CURRENT WALLET BALANCE
            </h6>

            <div class="wallet-balance">

              ₹ <%= admin_data.wallet || 0 %>

            </div>

          </div>

          <!-- FORM -->

          <form
            class="row g-4"
            action="/add_balance_post"
            method="POST"
          >

            <!-- AMOUNT -->

            <div class="col-md-12">

              <label class="form-label">
                Enter Amount
              </label>

              <div class="input-group">

                <span class="input-group-text">
                  ₹
                </span>

                <input
                  type="number"
                  class="form-control"
                  id="amount"
                  name="amount"
                  placeholder="Enter amount"
                  required
                >

              </div>

              <!-- QUICK BUTTONS -->

              <div class="quick-amounts">

                <button
                  type="button"
                  class="quick-btn"
                  onclick="setAmount(500)"
                >
                  ₹500
                </button>

                <button
                  type="button"
                  class="quick-btn"
                  onclick="setAmount(1000)"
                >
                  ₹1000
                </button>

                <button
                  type="button"
                  class="quick-btn"
                  onclick="setAmount(2000)"
                >
                  ₹2000
                </button>

                <button
                  type="button"
                  class="quick-btn"
                  onclick="setAmount(5000)"
                >
                  ₹5000
                </button>

                <button
                  type="button"
                  class="quick-btn"
                  onclick="setAmount(10000)"
                >
                  ₹10000
                </button>

              </div>

            </div>

            <!-- BUTTONS -->

            <div class="col-12 mt-4 text-center">

              <button
                type="submit"
                class="submit-btn"
              >

                <i class="bi bi-plus-circle-fill me-2"></i>

                Add Balance

              </button>

              <button
                type="reset"
                class="btn btn-secondary reset-btn ms-3"
              >

                Reset

              </button>

            </div>

          </form>

        </div>

      </div>

    </section>

  </main>

  <!-- FOOTER -->

  <%- include("../../utils/footer") %>

  <!-- BACK TO TOP -->

  <a
    href="#"
    class="back-to-top d-flex align-items-center justify-content-center"
  >

    <i class="bi bi-arrow-up-short"></i>

  </a>

  <!-- JS -->

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

  <script src="/assets/js/main.js"></script>

  <script>

    function setAmount(amount) {

      document.getElementById(
        "amount"
      ).value = amount;

    }

  </script>

</body>

</html>
