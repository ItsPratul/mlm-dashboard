<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>MLM | Admin Login</title>

    <!-- Favicon -->
    <link href="assets/img/favicon.png" rel="icon" />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap -->
    <link
      href="assets/vendor/bootstrap/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      href="assets/vendor/bootstrap-icons/bootstrap-icons.css"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        font-family: "Poppins", sans-serif;
        background: linear-gradient(
          135deg,
          #050816 0%,
          #0f172a 45%,
          #111827 100%
        );
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .main-box {
        width: 100%;
        max-width: 860px;
      }

      .brand {
        text-align: center;
        margin-bottom: 16px;
      }

      .brand h1 {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 5px;
        color: #ffffff;
      }

      .brand span {
        color: #a78bfa;
      }

      .brand p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 13px;
      }

      .login-card {
        background: #ffffff;
        border-radius: 22px;
        overflow: hidden;
        display: flex;
        min-height: 420px;
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.22);
      }

      .left-side {
        width: 40%;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        padding: 30px 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .left-side h2 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 12px;
        line-height: 1.4;
      }

      .left-side p {
        color: rgba(255, 255, 255, 0.88);
        line-height: 1.7;
        font-size: 13px;
      }

      .feature-box {
        margin-top: 22px;
      }

      .feature-item {
        display: flex;
        align-items: center;
        margin-bottom: 13px;
        font-size: 13px;
      }

      .feature-item i {
        margin-right: 10px;
        font-size: 15px;
      }

      .right-side {
        width: 60%;
        padding: 30px 28px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .login-title {
        font-size: 26px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 6px;
      }

      .login-subtitle {
        color: #6b7280;
        margin-bottom: 22px;
        font-size: 13px;
      }

      .form-label {
        font-size: 13px;
        font-weight: 500;
        color: #374151;
        margin-bottom: 7px;
      }

      .input-group {
        margin-bottom: 15px;
      }

      .input-group-text {
        border-radius: 12px 0 0 12px;
        background: #f3f4f6;
        border: 1px solid #d1d5db;
        padding: 0 14px;
      }

      .form-control {
        height: 46px;
        border-radius: 0 12px 12px 0;
        border: 1px solid #d1d5db;
        box-shadow: none !important;
        font-size: 14px;
      }

      .form-control:focus {
        border-color: #7c3aed;
      }

      .login-btn {
        width: 100%;
        height: 46px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(to right, #4f46e5, #7c3aed);
        color: white;
        font-size: 14px;
        font-weight: 600;
        transition: 0.3s;
        margin-top: 4px;
      }

      .login-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(124, 58, 237, 0.35);
      }

      .demo-box {
        margin-top: 16px;
        background: #f9fafb;
        border: 1px dashed #d1d5db;
        border-radius: 14px;
        padding: 14px;
        text-align: center;
      }

      .demo-box h6 {
        font-weight: 700;
        margin-bottom: 7px;
        color: #7c3aed;
        font-size: 14px;
      }

      .demo-box p {
        margin: 3px 0;
        font-size: 12px;
        color: #4b5563;
      }

      .footer-text {
        margin-top: 14px;
        text-align: center;
        color: rgba(255, 255, 255, 0.55);
        font-size: 12px;
      }

      @media (max-width: 850px) {
        body {
          padding: 16px;
        }

        .login-card {
          flex-direction: column;
        }

        .left-side,
        .right-side {
          width: 100%;
        }

        .left-side {
          padding: 28px 22px;
        }

        .right-side {
          padding: 28px 22px;
        }

        .brand h1 {
          font-size: 30px;
        }

        .login-title {
          font-size: 24px;
        }
      }
    </style>
  </head>

  <body>
    <%- include("../../utils/flash"); %>

    <div class="main-box">
      <div class="brand">
        <h1>M<span>LM</span></h1>

        <p>Secure Referral & Wallet Management Dashboard</p>
      </div>

      <div class="login-card">
        <div class="left-side">
          <h2>Manage Your Network Efficiently</h2>

          <p>
            Access referrals, commissions, wallet transactions, and analytics
            through a secure and modern dashboard system.
          </p>

          <div class="feature-box">
            <div class="feature-item">
              <i class="bi bi-check-circle-fill"></i>
              Referral Tracking
            </div>

            <div class="feature-item">
              <i class="bi bi-wallet2"></i>
              Wallet Monitoring
            </div>

            <div class="feature-item">
              <i class="bi bi-bar-chart-fill"></i>
              Dashboard Analytics
            </div>
          </div>
        </div>

        <div class="right-side">
          <h2 class="login-title">Welcome Back!</h2>

          <p class="login-subtitle">Sign in to continue to your dashboard</p>

          <form action="/user_login_save" method="post">
            <div>
              <label class="form-label">Email Address</label>

              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-envelope-fill"></i>
                </span>

                <input
                  type="email"
                  name="email"
                  class="form-control"
                  placeholder="Enter your email address"
                  required
                />
              </div>
            </div>

            <div>
              <label class="form-label">Password</label>

              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-lock-fill"></i>
                </span>

                <input
                  type="password"
                  name="password"
                  class="form-control"
                  placeholder="Enter your password"
                  required
                />
              </div>
            </div>

            <button class="login-btn" type="submit">
              <i class="bi bi-box-arrow-in-right"></i>
              Sign In
            </button>
          </form>

          <div class="demo-box">
            <h6>Demo Access</h6>

            <p>Email: admin@gmail.com</p>

            <p>Password: Available on request</p>
          </div>
        </div>
      </div>

      <p class="footer-text">© 2026 Pratul Khandelwal. All rights reserved.</p>
    </div>

    <script src="assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
