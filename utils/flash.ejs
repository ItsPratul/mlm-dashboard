<style>
  .flash-center {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    min-width: 340px;
    max-width: 90%;
    padding: 16px 20px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    z-index: 999999;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 500;
    animation: flashSlide 0.35s ease;
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .flash-icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .flash-text {
    flex: 1;
    line-height: 1.5;
    font-size: 14px;
    font-weight: 500;
  }

  /* SUCCESS */

  .success {
    background: #ecfdf5;
    border-left: 5px solid #10b981;
  }

  .success .flash-icon {
    background: #10b981;
    color: white;
  }

  .success .flash-text {
    color: #065f46;
  }

  /* ERROR */

  .error {
    background: #fef2f2;
    border-left: 5px solid #ef4444;
  }

  .error .flash-icon {
    background: #ef4444;
    color: white;
  }

  .error .flash-text {
    color: #991b1b;
  }

  /* WARNING */

  .warning {
    background: #fffbeb;
    border-left: 5px solid #f59e0b;
  }

  .warning .flash-icon {
    background: #f59e0b;
    color: white;
  }

  .warning .flash-text {
    color: #92400e;
  }

  /* INFO */

  .info {
    background: #eff6ff;
    border-left: 5px solid #3b82f6;
  }

  .info .flash-icon {
    background: #3b82f6;
    color: white;
  }

  .info .flash-text {
    color: #1e40af;
  }

  @keyframes flashSlide {
    from {
      opacity: 0;
      transform: translate(-50%, -20px);
    }

    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 600px) {
    .flash-center {
      width: calc(100% - 24px);
      min-width: auto;
      top: 16px;
      padding: 14px 16px;
    }

    .flash-text {
      font-size: 13px;
    }
  }
</style>

<% if (message.success) { %>
<div class="flash-center success">
  <div class="flash-icon">✓</div>

  <div class="flash-text">
    <%= message.success %>
  </div>
</div>
<% } %>

<% if (message.error) { %>
<div class="flash-center error">
  <div class="flash-icon">✕</div>

  <div class="flash-text">
    <%= message.error %>
  </div>
</div>
<% } %>

<% if (message.warning) { %>
<div class="flash-center warning">
  <div class="flash-icon">!</div>

  <div class="flash-text">
    <%= message.warning %>
  </div>
</div>
<% } %>

<% if (message.info) { %>
<div class="flash-center info">
  <div class="flash-icon">i</div>

  <div class="flash-text">
    <%= message.info %>
  </div>
</div>
<% } %>

<script>
  setTimeout(() => {
    const flash = document.querySelector(".flash-center");

    if (flash) {
      flash.style.transition = "all 0.35s ease";

      flash.style.opacity = "0";

      flash.style.transform =
        "translate(-50%, -20px)";

      setTimeout(() => {
        flash.remove();
      }, 350);
    }
  }, 2800);
</script>